# Copia este archivo como `.env` (no se versiona).

# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP (Railway define PORT automáticamente)
PORT=8080
HOST=0.0.0.0
# Puerto HTTP/2 sin TLS para clientes gRPC nativos (bot CLI). Opcional.
GRPC_PORT=8081

# Postgres local (`pnpm db:up`). Si se omite en desarrollo, se usa almacenamiento en memoria.
DATABASE_URL=postgres://typerace:typerace@localhost:5433/typerace
# Base desechable para tests de integración: ¡el test borra su esquema!
TEST_DATABASE_URL=postgres://typerace:typerace@localhost:5433/typerace_test

# Orígenes permitidos (separados por comas, admite `*`). En desarrollo localhost ya está permitido.
CORS_ORIGIN=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
