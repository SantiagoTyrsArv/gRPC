{
  "name": "@typerace/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de TypeRace: Connect RPC (gRPC, gRPC-Web y Connect) sobre Node.js",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-fastify": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@fastify/cors": "^11.3.1",
    "@typerace/proto-gen": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
