{
  "name": "@typerace/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de TypeRace: Connect RPC (gRPC, gRPC-Web y Connect) sobre Node.js",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typerace/proto-gen": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
