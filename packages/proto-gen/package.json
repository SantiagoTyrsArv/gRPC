{
  "name": "@typerace/proto-gen",
  "version": "0.1.0",
  "private": true,
  "description": "Código TypeScript generado desde los contratos .proto (compartido por server, web y bot)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "cd ../.. && buf generate",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "typescript": "6.0.3"
  }
}
